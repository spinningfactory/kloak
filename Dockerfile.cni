FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build CNI plugin
RUN CGO_ENABLED=0 go build -o /out/kloak-cni ./cmd/cni-plugin

FROM alpine:3.19

# Install necessary tools for the installer script (jq for JSON manipulation)
RUN apk add --no-cache jq

COPY --from=builder /out/kloak-cni /opt/cni/bin/kloak-cni
COPY images/cni-install/install-cni.sh /install-cni.sh

CMD ["/install-cni.sh"]
